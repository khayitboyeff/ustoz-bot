# Ushbu faylni .env nomi bilan nusxalang. Tokenni chat yoki GitHub'ga yubormang.
BOT_TOKEN=PASTE_TELEGRAM_BOT_TOKEN_HERE
ADMIN_IDS=123456789
DATABASE_PATH=/opt/cyberustozbot/app/database/cyberlearn.db
LOG_LEVEL=INFO

# Karta orqali qo'lda tasdiqlash ixtiyoriy. Bo'sh qoldirish mumkin.
PAYMENT_CARD_NUMBER=
PAYMENT_CARD_HOLDER=
PAYMENT_CARD_BANK=
PAYMENT_CARD_INSTRUCTIONS=To'lovdan keyin chekni yuboring. Admin bank ilovasida tekshiradi.

# Ixtiyoriy API / AI sozlamalari. Ishlatmasangiz bo'sh qoldiring.
IPWHOIS_API_KEY=
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_TIMEOUT_SECONDS=20
AI_DAILY_LIMIT_FREE=5
AI_DAILY_LIMIT_PREMIUM=30
